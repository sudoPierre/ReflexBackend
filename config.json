{
  "repo_url": "https://github.com/myusername/myproject",
  "branch": "main",
  "backend_path": "my-backend",
  "start_commands": [
    "echo Starting backend...",
    "cd my-backend",
    "nohup python3 main.py &"
  ],
  "stop_commands": [
    "echo Stopping backend...",
    "pkill -f my-backend"
  ]
}
